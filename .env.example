# ---- Supabase (public, safe for the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Build-time (GitHub Pages project sites live under /<repo>/) ----
# Set to "/kendra" for https://<user>.github.io/kendra — leave blank for a root domain
NEXT_PUBLIC_BASE_PATH=

# ---- Server / Edge Function secrets (NEVER expose to the browser) ----
# Set these with: supabase secrets set NAME=value
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://YOUR-PROJECT.supabase.co/functions/v1/gbp-oauth-callback
# AI drafting provider: openai | sarvam | none (none = deterministic template drafts)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
